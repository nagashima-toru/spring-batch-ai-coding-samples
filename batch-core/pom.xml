<?xml version="1.0" encoding="UTF-8"?>
<!--
  batch-core: バッチ基盤部品ライブラリ

  全ジョブが共通利用する部品（HTTP Client基盤・共通Tasklet・共通ItemReader/Processor/Writer・
  例外階層・ジョブ実行制御・ロギング）を提供する。
  アプリケーション（batch-sample 等）はこのモジュールに依存し、独自実装せず基盤部品を利用すること。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.batch</groupId>
        <artifactId>spring-batch-ai-samples</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>batch-core</artifactId>
    <name>batch-core</name>
    <description>バッチ基盤部品（共通ライブラリ）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>
        <!-- RestClient（HTTP Client 基盤で使用） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- Bean Validation（バリデーション付き Processor 基盤で使用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- MyBatisCursorItemReader 等のバッチ連携部品 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>

        <!-- テスト -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.batch</groupId>
            <artifactId>spring-batch-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
