<?xml version="1.0" encoding="UTF-8"?>
<!--
  batch-sample: サンプルアプリケーション

  batch-core の基盤部品を利用した実務パターンのリファレンス実装（リファレンスサンプル9本＋案件ジョブ3本）。
  1つの実行可能Jar/コンテナに全ジョブを同梱し、起動時に spring.batch.job.name で実行ジョブを選択する。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.batch</groupId>
        <artifactId>spring-batch-ai-samples</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>batch-sample</artifactId>
    <name>batch-sample</name>
    <description>基盤部品を利用したサンプルバッチアプリケーション</description>

    <dependencies>
        <dependency>
            <groupId>com.example.batch</groupId>
            <artifactId>batch-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- ジョブメタデータのDB永続化（リスタートに必須）。
             Boot 4 の既定はインメモリ（Resourceless）のため、JDBC リポジトリを明示的に有効化する -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch-jdbc</artifactId>
        </dependency>

        <!-- DBマイグレーション（BATCH_*メタデータ・業務スキーマとも Flyway で管理）
             Boot 4 は自動構成がモジュール分割されているため flyway-core 単体でなく starter を使う -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- テスト -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.batch</groupId>
            <artifactId>spring-batch-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 結合テスト: 本番同一バージョンの PostgreSQL コンテナを使用（Testcontainers 2系） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- コンテナイメージビルド（Jib: Dockerデーモン不要・レイヤ最適化。CD から jib:build で使用） -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <configuration>
                    <from>
                        <image>eclipse-temurin:25-jre</image>
                    </from>
                    <!-- push 先（-Djib.to.image で CD が上書きする） -->
                    <to>
                        <image>batch-sample</image>
                    </to>
                    <container>
                        <!-- ECS ではタスク定義の command 上書きでジョブ名・パラメータを指定する -->
                        <jvmFlags>
                            <jvmFlag>-XX:MaxRAMPercentage=75.0</jvmFlag>
                            <jvmFlag>-Dfile.encoding=UTF-8</jvmFlag>
                        </jvmFlags>
                        <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                    </container>
                </configuration>
            </plugin>
            <!-- カバレッジ対象外: 起動クラスと骨格サンプル（07〜09。docs/architecture.md §12） -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>com/example/batch/sample/BatchSampleApplication.class</exclude>
                        <exclude>com/example/batch/sample/job07_partitioning/**</exclude>
                        <exclude>com/example/batch/sample/job08_s3_io/**</exclude>
                        <exclude>com/example/batch/sample/job09_notification/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
